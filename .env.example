# Copy this file to .env and keep the key on the server only.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite

# [임시] 원격 팀원 테스트용 접속 비밀번호. 비워 두면 검사하지 않는다(로컬 개발). npm run tunnel은 이 값이 있어야 열린다.
TEST_PASSCODE=
# 사용자별 하루 LLM 호출 한도(기본 150, 0이면 제한 없음).
LLM_DAILY_LIMIT=150
# 체크포인트 DB 파일(기본 data/st-rookie.sqlite).
# DB_PATH=
